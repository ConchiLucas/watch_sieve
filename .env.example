# LLM calls go through local_config_center. Do not put vendor keys or vendor URLs here.
WATCH_SIEVE_GATEWAY_BASE_URL=http://127.0.0.1:18527
WATCH_SIEVE_GATEWAY_AUTH=local-gateway
WATCH_SIEVE_CHAT_TIMEOUT_SECONDS=90
# Chat slug from GET /v1/models. Must include vendor prefix.
WATCH_SIEVE_CHAT_MODEL=aurora/gpt-5-6-mini

# Optional: browser crawl
# PLAYWRIGHT_BROWSERS_PATH=

# SnailJob Python executor
# Example: Python on the host, SnailJob in Docker Desktop.
# SNAIL_HOST_IP must be reachable from the server container.
# Linux Docker may need extra_hosts: ["host.docker.internal:host-gateway"].
# Colima DNS support depends on its version/configuration.
SNAIL_SERVER_HOST=127.0.0.1
SNAIL_SERVER_PORT=17888
SNAIL_HOST_IP=host.docker.internal
SNAIL_HOST_PORT=17889
SNAIL_NAMESPACE=
SNAIL_GROUP_NAME=watch_sieve
SNAIL_TOKEN=
SNAIL_LABELS=env:local,app:watch-sieve

# Titles are stored in the local postgres16 container, not snail_job.
# Create an isolated database first: CREATE DATABASE watch_sieve;
WATCH_SIEVE_DATABASE_URL=postgresql://conchi@127.0.0.1:5432/watch_sieve
